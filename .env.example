# Copy to .env and fill in. Never commit .env.

# Decision provider: "rules" (default, no key needed), "gemini" or "jev"
DECISION_PROVIDER=rules

# Gemini (LLM baseline)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Jev (TypeSafe) - leave empty until your key arrives
TYPESAFE_API_KEY=
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# HubSpot test account private app token (used from Week 3)
HUBSPOT_TOKEN=

# Local dev without Docker falls back to SQLite
# DATABASE_URL=sqlite:///./bridgeops.db
