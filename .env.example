# Copy to .env and fill in. Never commit .env.

# Decision provider: "rules" (default, no key needed), "gemini" or "jev"
DECISION_PROVIDER=rules

# Gemini (LLM baseline)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Jev (TypeSafe) - leave empty until your key arrives
TYPESAFE_API_KEY=
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# HubSpot TEST account private app token (scopes: crm.objects.contacts.read,
# crm.objects.contacts.write, crm.schemas.contacts.read). Without it, only dry runs work.
HUBSPOT_TOKEN=
# Client-side rate limit; private apps on Free/Starter allow 100 requests per 10 seconds
# HUBSPOT_REQUESTS_PER_10S=90

# Local dev without Docker falls back to SQLite
# DATABASE_URL=sqlite:///./bridgeops.db

# Sign-in. The first account is created on startup from these when there are no users yet.
# Or create accounts any time with: python scripts/users.py create you@example.com
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set to true when the app is served over HTTPS
COOKIE_SECURE=false
